# LLM Provider configuration
# Options: "ollama", "gemini", "groq", "openai"
LLM_PROVIDER=ollama

# Ollama Configuration (Default free local model)
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# Google Gemini Configuration (Optional free tier cloud)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# Groq Configuration (Optional fast cloud)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI / OpenRouter Configuration (Optional)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Search & Extraction Settings
MAX_SEARCH_RESULTS=5
MAX_SEARCH_RETRIES=3
FETCH_TIMEOUT_SECONDS=10

# LangSmith Tracing & Observability (Optional)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=Financial-Policy-Research-Agent
